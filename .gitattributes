# Store text files with LF line endings in the repo and the working tree, so
# Windows (core.autocrlf=true) stops warning "LF will be replaced by CRLF".
* text=auto eol=lf

# Binary assets: never touch line endings or try to diff them as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.avif binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
